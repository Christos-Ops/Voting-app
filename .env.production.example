# Copy this template to /opt/voting-app/.env on the EC2 instance.
# Replace the placeholders. Never commit the real .env file.
# Use a hexadecimal database password so it is safe inside database URLs.
POSTGRES_DB=voting
POSTGRES_USER=voting_app
POSTGRES_PASSWORD=replace-with-output-from-openssl-rand-hex-32
JWT_SECRET_KEY=replace-with-output-from-openssl-rand-hex-32
RESULTS_CACHE_TTL=30
LOG_LEVEL=INFO
